				  }
				}

		annotation GroupingDesignState = {"Version":0,"Sources":[{"Name":"d","Entity":"Date"}],"GroupedColumns":[{"Column":{"Expression":{"SourceRef":{"Source":"d"}},"Property":"Date"}}],"BinItem":{"Expression":{"Floor":{"Expression":{"Column":{"Expression":{"SourceRef":{"Source":"d"}},"Property":"Date"}},"Size":1.0,"TimeUnit":2}}}}

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	partition Date = calculated
		mode: import
		source =
				
				VAR MinDate = DATE(2023, 1, 1)
				VAR MaxDate = DATE(2025, 12, 31)
				RETURN
				ADDCOLUMNS(
				    CALENDAR(MinDate, MaxDate),
				    "Year", YEAR([Date]),
				    "Month Number", MONTH([Date]),
				    "Month Name", FORMAT([Date], "MMM"),
				    "FY", YEAR([Date]) + IF(MONTH([Date]) >= 4, 1, 0)
				)

	annotation PBI_Id = b80d8194cb434adeab55d88d9012a13c

