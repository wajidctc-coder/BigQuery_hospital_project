	column 'Date (bins)' =
			IF(
				ISBLANK('Date'[Date]),
				BLANK(),
				DATE(
					YEAR('Date'[Date]),
					1 + (MONTH('Date'[Date]) - 1),
					1
				)
			)
		formatString: mmmm\, yyyy
		lineageTag: e48ab0a6-adbb-496a-9d6d-79cb62ff9c35
		summarizeBy: none

		extendedProperty GroupingMetadata =
				{
				  "version": 0,
