model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["daily_operations","disease_summary","seasonal_load","_measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table daily_operations
ref table disease_summary
ref table seasonal_load
ref table Date
ref table _measures

ref cultureInfo en-US

